<Page
    x:Class="Lively.UI.WinUI.Views.Pages.FolderEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibilityConverter" />
    </Page.Resources>

    <StackPanel MinWidth="420" Spacing="10">
        <TextBox
            x:Name="folderNameBox"
            x:Uid="FolderName"
            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock
            x:Uid="FolderCover"
            Margin="0,5,0,0"
            Style="{ThemeResource BodyStrongTextBlockStyle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="120"
                Height="80"
                Background="{ThemeResource SystemAltLowColor}"
                BorderBrush="{ThemeResource SystemChromeHighColor}"
                BorderThickness="1"
                CornerRadius="5">
                <Grid>
                    <Image
                        Source="{Binding CoverImage, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{Binding HasCoverImage, Mode=OneWay, Converter={StaticResource VisibilityConverter}}" />
                    <FontIcon
                        FontSize="24"
                        Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                        Glyph="&#xE91B;"
                        Visibility="{Binding HasCoverImage, Mode=OneWay, Converter={StaticResource VisibilityConverter}, ConverterParameter=Reverse}" />
                </Grid>
            </Border>

            <StackPanel
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Spacing="6">
                <Button x:Uid="SelectImage" Command="{Binding BrowseCoverImageCommand}" />
                <Button
                    x:Uid="ClearCover"
                    Command="{Binding ClearCoverImageCommand}"
                    Visibility="{Binding HasCoverImage, Mode=OneWay, Converter={StaticResource VisibilityConverter}}" />
            </StackPanel>
        </Grid>

        <TextBlock
            x:Uid="FolderCoverAutoHint"
            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />
    </StackPanel>
</Page>