<Page
    x:Class="Lively.UI.WinUI.Views.Pages.CollageWallpaperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:localConverters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
        <localConverters:BooleanToVisibilityConverter x:Key="VisibilityConverter" />
    </Page.Resources>

    <StackPanel MinWidth="460" Spacing="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="CollageImages"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Button
                x:Uid="CollageAddImages"
                Grid.Column="1"
                Command="{Binding AddImagesCommand}" />
        </Grid>

        <!--  Pictures, in the order they are laid out.  -->
        <Grid>
            <ListView
                MaxHeight="168"
                BorderBrush="{ThemeResource SystemChromeHighColor}"
                BorderThickness="1"
                CornerRadius="5"
                ItemsSource="{Binding Images}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="48"
                                Height="27"
                                Source="{Binding Path}"
                                Stretch="UniformToFill" />
                            <TextBlock
                                Grid.Column="1"
                                MaxLines="1"
                                Text="{Binding FileName}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="2"
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding MoveUpCommand}">
                                <FontIcon FontSize="12" Glyph="&#xE70E;" />
                                <ToolTipService.ToolTip>
                                    <TextBlock x:Uid="CollageMoveUp" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Button
                                Grid.Column="3"
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding MoveDownCommand}">
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                                <ToolTipService.ToolTip>
                                    <TextBlock x:Uid="CollageMoveDown" />
                                </ToolTipService.ToolTip>
                            </Button>
                            <Button
                                Grid.Column="4"
                                Padding="6"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding RemoveCommand}">
                                <FontIcon FontSize="12" Glyph="&#xE711;" />
                                <ToolTipService.ToolTip>
                                    <TextBlock x:Uid="CollageRemove" />
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Uid="CollageEmpty"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                IsHitTestVisible="False"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="{Binding HasImages, Converter={StaticResource VisibilityConverter}, ConverterParameter=Reverse}" />
        </Grid>

        <Grid ColumnSpacing="10" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Uid="CollageLayout"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectedIndex="{Binding LayoutIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="CollageLayoutHorizontal" />
                <ComboBoxItem x:Uid="CollageLayoutVertical" />
            </ComboBox>

            <TextBlock
                x:Uid="CollageFit"
                Grid.Row="1"
                VerticalAlignment="Center" />
            <ComboBox
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectedIndex="{Binding FitIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="CollageFitCrop" />
                <ComboBoxItem x:Uid="CollageFitContain" />
            </ComboBox>

            <TextBlock
                x:Uid="CollageGap"
                Grid.Row="2"
                VerticalAlignment="Center" />
            <Grid
                Grid.Row="2"
                Grid.Column="1"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    Maximum="64"
                    Minimum="0"
                    StepFrequency="1"
                    Value="{Binding Gap, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    MinWidth="28"
                    VerticalAlignment="Center"
                    Text="{Binding Gap}" />
            </Grid>
        </Grid>

        <TextBlock
            x:Uid="CollageHint"
            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            TextWrapping="Wrap" />

        <ProgressRing IsActive="{Binding IsRunning, Mode=OneWay}" />

        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Message="{Binding ErrorText, Mode=OneWay}"
            Severity="Error"
            Visibility="{Binding ErrorText, Converter={StaticResource StringVisibilityConverter}, Mode=OneWay}" />
    </StackPanel>
</Page>
